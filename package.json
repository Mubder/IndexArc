{
  "name": "indexarc",
  "private": true,
  "version": "2.1.0",
  "description": "Portable personal vault — paste secrets, multi-extract, name, ask in AR/EN",
  "author": "IndexArc",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "electron-main.cjs",
  "bin": {
    "indexarc": "bin/indexarc.mjs"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --external:electron --banner:js=\"const __importMetaUrl = require('url').pathToFileURL(__filename).href;\" --define:import.meta.url=__importMetaUrl --sourcemap --outfile=dist/server.cjs && esbuild server/services/parseWorker.ts --bundle --platform=node --format=cjs --external:vite --external:electron --banner:js=\"const __importMetaUrl = require('url').pathToFileURL(__filename).href;\" --define:import.meta.url=__importMetaUrl --sourcemap --outfile=dist/parse-worker.cjs && node scripts/copy-pdf-worker.cjs && node scripts/write-dist-manifest.cjs",
    "start": "node dist/server.cjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true}); try{require('fs').rmSync('dist-desktop',{recursive:true,force:true})}catch(e){}\"",
    "lint": "tsc --noEmit && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "bench": "vitest run --config vitest.bench.config.ts",
    "build:cli": "node scripts/build-cli-sea.mjs",
    "test:watch": "vitest",
    "check:dist": "node scripts/check-dist.cjs",
    "desktop": "npm run build && npm run check:dist && electron electron-main.cjs",
    "desktop:pack": "npm run build && npm run check:dist && npm run build:cli && electron-builder --dir --win",
    "desktop:win": "npm run build && npm run check:dist && npm run build:cli && electron-builder --win portable nsis --x64 --publish never",
    "desktop:mac": "npm run build && npm run check:dist && npm run build:cli && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "desktop:linux": "npm run build && npm run check:dist && npm run build:cli && electron-builder --linux AppImage tar.gz --x64 --publish never",
    "desktop:dist": "npm run desktop:win"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.2",
    "@milkdown/crepe": "^7.23.0",
    "@napi-rs/canvas": "0.1.80",
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^5.4.296",
    "cspell-lib": "^10.0.1",
    "electron-updater": "^6.6.2",
    "nspell": "^2.1.5"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-virtual": "^3.13.12",
    "@tiptap/extension-color": "^3.30.5",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-text-style": "^3.30.5",
    "@tiptap/extension-typography": "^3.30.5",
    "@tiptap/extension-underline": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.12",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "dotenv": "^17.2.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "fast-check": "^4.3.0",
    "hash-wasm": "^4.12.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.79.0",
    "pdf-parse": "^2.4.5",
    "postject": "1.0.0-alpha.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11",
    "zod": "4.6.7"
  },
  "build": {
    "appId": "com.indexarc.vault",
    "productName": "IndexArc",
    "copyright": "Copyright © 2026 Mubder. Licensed under GPL-3.0.",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "assets"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Mubder",
        "repo": "IndexArc",
        "releaseType": "release"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "icon": "assets/icon.png",
    "files": [
      "dist/**/*",
      "public/**/*",
      "dictionaries/**/*",
      "!dictionaries/ar_trie/cspell-dict-ar-1.1.7.tgz",
      "shared/**/*",
      "node_modules/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "dist-manifest.json",
      "package.json",
      "!node_modules/electron{,/**/*}",
      "!node_modules/@esbuild{,/**/*}",
      "!node_modules/esbuild{,/**/*}",
      "!node_modules/vite{,/**/*}",
      "!node_modules/typescript{,/**/*}",
      "!node_modules/tsx{,/**/*}",
      "!node_modules/@types{,/**/*}",
      "!**/{docs,test,tests,examples,coverage}/**/*",
      "!dist/**/*.map",
      "!**/*.test.{ts,js,cjs,mjs}",
      "!data{,/**/*}",
      "!config{,/**/*}",
      "!logs{,/**/*}",
      "!tmp{,/**/*}",
      "!backups{,/**/*}",
      "!.desktop-sandbox{,/**/*}",
      "!dist-desktop{,/**/*}",
      "!dist-desktop2{,/**/*}",
      "!dist-desktop-release{,/**/*}",
      "!**/*vault*.json",
      "!**/*vector*.json",
      "!**/scan_sessions.json",
      "!**/watched_folders.json",
      "!**/settings.json",
      "!**/.env",
      "!**/.env.*"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "asarUnpack": [
      "dist/**/*",
      "node_modules/@napi-rs/**/*",
      "public/**/*",
      "dictionaries/**/*"
    ],
    "extraMetadata": {
      "main": "electron-main.cjs"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "IndexArc-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IndexArc",
      "include": "build/installer.nsh",
      "artifactName": "IndexArc-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "build/cli",
        "to": "cli",
        "filter": [
          "indexarc",
          "indexarc.exe"
        ]
      },
      {
        "from": "bin",
        "to": "cli",
        "filter": [
          "indexarc.mjs"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ]
  }
}
