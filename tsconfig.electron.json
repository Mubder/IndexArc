{
  // Type-checks the Electron main/preload processes (plain CommonJS .cjs).
  // Run by `npm run lint` alongside the main tsconfig. checkJs stays off:
  // files opt in with a `// @ts-check` header (preload.cjs, shared/verify-dist.cjs).
  // electron-main.cjs is parsed but not yet opted in — 73 strict-mode errors
  // (mostly implicit any) remain to burn down; see docs/INDUSTRIAL_ROADMAP.md R2.2.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "files": ["electron-main.cjs", "preload.cjs", "shared/verify-dist.cjs"]
}
