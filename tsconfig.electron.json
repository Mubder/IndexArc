{
  // Type-checks the Electron main/preload processes (plain CommonJS .cjs).
  // Run by `npm run lint` alongside the main tsconfig. checkJs stays off:
  // files opt in with a `// @ts-check` header. All listed files
  // (electron-main.cjs, preload.cjs, shared/verify-dist.cjs) are opted in and
  // pass strict mode.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "files": ["electron-main.cjs", "preload.cjs", "shared/verify-dist.cjs", "shared/updater.cjs"]
}
